{
  "name": "an-favorites",
  "displayName": "AnFavorites",
  "description": "Application for managing favorites",
  "version": "0.8.0",
  "publisher": "anappwilos",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/bootstrap/extension.js",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "anfavorites.hello",
        "title": "AnFavorites: Hello"
      },
      {
        "command": "anfavorites.openWebview",
        "title": "AnFavorites: Open Webview"
      },
      {
        "command": "anfavorites.showLogs",
        "title": "AnFavorites: Show Logs"
      },
      {
        "command": "anfavorites.addToFavorites",
        "title": "Añadir a Favoritos"
      },
      {
        "command": "anfavorites.removeFromFavorites",
        "title": "Eliminar de Favoritos"
      },
      {
        "command": "anfavorites.addCategory",
        "title": "Nueva Categoría"
      },
      {
        "command": "anfavorites.removeCategory",
        "title": "Eliminar Categoría"
      },
      {
        "command": "anfavorites.renameCategory",
        "title": "Renombrar Categoría"
      },
      {
        "command": "anfavorites.moveFavorite",
        "title": "Mover a Categoría"
      },
      {
        "command": "anfavorites.quickOpen",
        "title": "Buscar Archivo (Favoritos)"
      }
    ],
    "keybindings": [
      {
        "command": "anfavorites.quickOpen",
        "key": "alt+shift+f",
        "mac": "alt+shift+f"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "anfavorites.favoritesView",
          "name": "Favoritos",
          "icon": "$(star)"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "anfavorites.addToFavorites",
          "when": "!explorerResourceIsFolder",
          "group": "2_workspace@1"
        }
      ],
      "view/title": [
        {
          "command": "anfavorites.addCategory",
          "when": "view == anfavorites.favoritesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "anfavorites.removeFromFavorites",
          "when": "view == anfavorites.favoritesView && viewItem == favoriteItem",
          "group": "favorites@1"
        },
        {
          "command": "anfavorites.moveFavorite",
          "when": "view == anfavorites.favoritesView && viewItem == favoriteItem",
          "group": "favorites@2"
        },
        {
          "command": "anfavorites.renameCategory",
          "when": "view == anfavorites.favoritesView && viewItem == categoryItem",
          "group": "category@1"
        },
        {
          "command": "anfavorites.removeCategory",
          "when": "view == anfavorites.favoritesView && viewItem == categoryItem",
          "group": "category@2"
        }
      ]
    },
    "configuration": {
      "title": "AnFavorites",
      "properties": {
        "anfavorites.enableGreeting": {
          "type": "boolean",
          "default": true,
          "description": "Enable greeting message."
        },
        "anfavorites.quickOpen.maxRecentFavorites": {
          "type": "number",
          "default": 3,
          "enum": [
            2,
            3,
            4,
            5,
            10
          ],
          "description": "Número de favoritos recientes a mostrar en Quick Open."
        },
        "anfavorites.quickOpen.maxRecentFiles": {
          "type": "number",
          "default": 3,
          "enum": [
            2,
            3,
            4,
            5,
            10
          ],
          "description": "Número de archivos recientemente abiertos a mostrar en Quick Open."
        },
        "anfavorites.quickOpen.ignoreFocusOut": {
          "type": "boolean",
          "default": false,
          "description": "Controla si el Quick Open se cierra al perder el foco (false) o se mantiene abierto (true)."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "compile": "node scripts/esbuild.js",
    "watch": "node scripts/esbuild.js --watch",
    "compile-tests": "tsc -p test/tsconfig.json",
    "test": "npm run compile-tests && node ./out/test/runTest.js",
    "prepublishOnly": "npm run lint && npm run test && npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^25.0.6",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
