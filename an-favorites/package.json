{
  "name": "an-favorites",
  "displayName": "AnFavorites",
  "description": "Application for managing favorites",
  "version": "0.8.76",
  "publisher": "anappwilos",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/bootstrap/extension.js",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "anfavorites.addToFavorites",
        "title": "Añadir a Favoritos",
        "category": "AnFavorites"
      },
      {
        "command": "anfavorites.addToFavoritesInGroup",
        "title": "Añadir a Favoritos (Elegir Grupo)",
        "category": "AnFavorites"
      },
      {
        "command": "anfavorites.removeFromFavorites",
        "title": "Eliminar de Favoritos",
        "category": "AnFavorites",
        "icon": "$(trash)"
      },
      {
        "command": "anfavorites.removeAllFavorites",
        "title": "Eliminar Todo",
        "category": "AnFavorites",
        "icon": "$(trash)"
      },
      {
        "command": "anfavorites.addGroup",
        "title": "Nuevo Grupo",
        "category": "AnFavorites"
      },
      {
        "command": "anfavorites.removeGroup",
        "title": "Eliminar Grupo",
        "category": "AnFavorites",
        "icon": "$(trash)"
      },
      {
        "command": "anfavorites.renameGroup",
        "title": "Renombrar Grupo",
        "category": "AnFavorites",
        "icon": "$(edit)"
      },
      {
        "command": "anfavorites.pinFavorite",
        "title": "Fijar Favorito",
        "category": "AnFavorites",
        "icon": "$(pin)"
      },
      {
        "command": "anfavorites.unpinFavorite",
        "title": "Desfijar Favorito",
        "category": "AnFavorites",
        "icon": "$(pinned)"
      },
      {
        "command": "anfavorites.moveFavorite",
        "title": "Mover a Grupo",
        "category": "AnFavorites"
      },
      {
        "command": "anfavorites.openToSide",
        "title": "Abrir al lado",
        "category": "AnFavorites",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "anfavorites.quickOpen",
        "title": "Buscar Archivo (Favoritos)",
        "category": "AnFavorites"
      },
      {
        "command": "anfavorites.clearGroup",
        "title": "Limpiar Grupo",
        "category": "AnFavorites",
        "icon": "$(clear-all)"
      },
      {
        "command": "anfavorites.removeFromGroup",
        "title": "Quitar del Grupo",
        "category": "AnFavorites",
        "icon": "$(close)"
      }
    ],
    "keybindings": [
      {
        "command": "anfavorites.quickOpen",
        "key": "alt+shift+f",
        "mac": "alt+shift+f"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "anfavorites.favoritesView",
          "name": "Favoritos",
          "icon": "resources/icon_no_bg.svg"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "anfavorites.addToFavorites",
          "group": "modification"
        },
        {
          "command": "anfavorites.addToFavoritesInGroup",
          "group": "modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "anfavorites.addToFavorites",
          "group": "1_modification"
        },
        {
          "command": "anfavorites.addToFavoritesInGroup",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "anfavorites.addToFavorites",
          "when": "!explorerResourceIsFolder",
          "group": "2_workspace@1"
        },
        {
          "command": "anfavorites.addToFavoritesInGroup",
          "when": "!explorerResourceIsFolder",
          "group": "2_workspace@2"
        }
      ],
      "view/title": [
        {
          "command": "anfavorites.addGroup",
          "when": "view == anfavorites.favoritesView",
          "group": "navigation"
        },
        {
          "command": "anfavorites.removeAllFavorites",
          "when": "view == anfavorites.favoritesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "anfavorites.openToSide",
          "when": "view == anfavorites.favoritesView && viewItem =~ /favoriteItem/",
          "group": "inline@1"
        },
        {
          "command": "anfavorites.pinFavorite",
          "when": "view == anfavorites.favoritesView && viewItem =~ /^favoriteItem(:grouped)?$/",
          "group": "inline@0"
        },
        {
          "command": "anfavorites.unpinFavorite",
          "when": "view == anfavorites.favoritesView && viewItem =~ /^favoriteItem:pinned(:grouped)?$/",
          "group": "inline@0"
        },
        {
          "command": "anfavorites.removeFromFavorites",
          "when": "view == anfavorites.favoritesView && viewItem =~ /^favoriteItem(:pinned)?$/",
          "group": "inline@2"
        },
        {
          "command": "anfavorites.moveFavorite",
          "when": "view == anfavorites.favoritesView && viewItem =~ /favoriteItem/",
          "group": "favorites@1"
        },
        {
          "command": "anfavorites.renameGroup",
          "when": "view == anfavorites.favoritesView && viewItem =~ /groupItem/",
          "group": "inline"
        },
        {
          "command": "anfavorites.removeGroup",
          "when": "view == anfavorites.favoritesView && viewItem =~ /groupItem/",
          "group": "inline"
        },
        {
          "command": "anfavorites.clearGroup",
          "when": "view == anfavorites.favoritesView && viewItem == groupItem",
          "group": "inline"
        },
        {
          "command": "anfavorites.removeFromGroup",
          "when": "view == anfavorites.favoritesView && viewItem =~ /:grouped/",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "anfavorites.addToFavorites",
          "when": "false"
        },
        {
          "command": "anfavorites.removeFromFavorites",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Logging",
        "properties": {
          "anfavorites.logging.level": {
            "type": "string",
            "default": "info",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ],
            "description": "Nivel mínimo de logs que se escriben en el canal y archivos."
          },
          "anfavorites.logging.maxRotatedFiles": {
            "type": "number",
            "default": 5,
            "description": "Cantidad máxima de archivos de log rotados que se conservarán."
          }
        }
      },
      {
        "title": "General",
        "properties": {
          "anfavorites.maxItems.favorites": {
            "type": "number",
            "default": 3,
            "enum": [
              2,
              3,
              4,
              5,
              7
            ],
            "description": "Número de favoritos recientes a mostrar en Quick Open."
          },
          "anfavorites.maxItems.pinned": {
            "type": "number",
            "default": 3,
            "enum": [
              3,
              4,
              5
            ],
            "description": "Número máximo de favoritos fijados permitidos."
          },
          "anfavorites.maxItems.recentFiles": {
            "type": "number",
            "default": 3,
            "enum": [
              2,
              3,
              4,
              5
            ],
            "description": "Número de archivos recientemente abiertos a mostrar en Quick Open."
          },
          "anfavorites.multiroot.separation": {
            "type": "string",
            "default": "none",
            "enum": [
              "none",
              "ungrouped",
              "groups",
              "both"
            ],
            "enumDescriptions": [
              "Ninguna separación.",
              "Solo separar en el grupo 'Sin Grupo'.",
              "Solo separar en los grupos creados por el usuario.",
              "Separar en todos los grupos."
            ],
            "description": "Permite separar los favoritos por nombre de la carpeta del espacio de trabajo en entornos multi-root."
          }
        }
      },
      {
        "title": "Search",
        "properties": {
          "anfavorites.search.exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/node_modules/**",
              "**/dist/**",
              "**/build/**",
              "**/out/**",
              "**/coverage/**",
              "**/.cache/**",
              "**/.parcel-cache/**",
              "**/.turbo/**",
              "**/.next/**",
              "**/.nuxt/**",
              "**/.vite/**",
              "**/__pycache__/**",
              "**/.venv/**",
              "**/venv/**",
              "**/env/**",
              "**/ENV/**",
              "**/.pytest_cache/**",
              "**/.mypy_cache/**",
              "**/.ruff_cache/**",
              "**/.tox/**",
              "**/.ipynb_checkpoints/**",
              "**/target/**",
              "**/.gradle/**",
              "**/.settings/**",
              "**/.idea/**",
              "**/bin/**",
              "**/obj/**",
              "**/.vs/**",
              "**/TestResults/**",
              "**/artifacts/**",
              "**/cmake-build-*/**",
              "**/CMakeFiles/**",
              "**/.history/**"
            ],
            "description": "Patrones de exclusión para búsqueda de archivos (node_modules, dist, build, caches, etc.)."
          }
        }
      },
      {
        "title": "Quick Open",
        "properties": {
          "anfavorites.quickOpen.openToSide": {
            "type": "boolean",
            "default": true,
            "description": "Si está activado, al abrir un archivo desde Quick Open se abrirá automáticamente en el editor lateral y se ocultará el botón 'Abrir al lado'."
          },
          "anfavorites.quickOpen.showIcons": {
            "type": "boolean",
            "default": true,
            "description": "Mostrar iconos de archivo en la lista de Quick Open. Si está desactivado, solo se mostrarán las estrellas y botones."
          },
          "anfavorites.quickOpen.maxSearchResults": {
            "type": "number",
            "default": 200,
            "description": "Límite máximo de resultados mostrados al buscar archivos en Quick Open."
          },
          "anfavorites.quickOpen.maxSearchFiles": {
            "type": "number",
            "default": 1000,
            "description": "Umbral máximo de archivos que Quick Open puede recuperar por búsqueda antes de mostrar un aviso."
          },
          "anfavorites.quickOpen.searchCacheSize": {
            "type": "number",
            "default": 30,
            "description": "Tamaño máximo del caché LRU de búsquedas en Quick Open."
          },
          "anfavorites.quickOpen.pathDetailLocation": {
            "type": "string",
            "default": "detail",
            "enum": [
              "description",
              "detail"
            ],
            "enumDescriptions": [
              "Muestra la información de la ruta seguida del nombre del archivo.",
              "Muestra la información de la ruta debajo del nombre del archivo."
            ],
            "description": "Controla dónde se muestra la información detallada de la ruta del archivo (especialmente en multi-root)."
          },
          "anfavorites.quickOpen.showPathWhen": {
            "type": "string",
            "default": "onConflict",
            "enum": [
              "always",
              "onConflict"
            ],
            "enumDescriptions": [
              "Siempre muestra la ruta del archivo.",
              "Solo muestra la ruta cuando hay archivos con el mismo nombre."
            ],
            "description": "Controla cuándo se muestra la ruta del archivo en Quick Open."
          }
        }
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "compile": "node scripts/esbuild.js",
    "watch": "node scripts/esbuild.js --watch",
    "compile-tests": "tsc -p test/tsconfig.json",
    "test": "npm run compile-tests && node ./out/test/runTest.js",
    "prepublishOnly": "npm run lint && npm run test && npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "minimatch": "^9.0.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^25.0.6",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "mocha": "^11.3.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
