{
  "name": "an-favorites",
  "displayName": "AnFavorites",
  "description": "Application for managing favorites",
  "version": "0.2.0",
  "publisher": "anappwilos",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:anfavorites.hello",
    "onCommand:anfavorites.openWebview"
  ],
  "main": "./dist/extension.js",

  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],

  "contributes": {
    "commands": [
      {
        "command": "anfavorites.hello",
        "title": "AnFavorites: Hello"
      },
      {
        "command": "anfavorites.openWebview",
        "title": "AnFavorites: Open Webview"
      }
    ],
    "configuration": {
      "title": "AnFavorites",
      "properties": {
        "anfavorites.enableGreeting": {
          "type": "boolean",
          "default": true,
          "description": "Habilita el saludo."
        }
      }
    }
  },

  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "compile": "node scripts/esbuild.js",
    "watch": "node scripts/esbuild.js --watch",
    "compile-tests": "tsc -p test/tsconfig.json",
    "test": "npm run compile-tests && node ./out/test/runTest.js",
    "prepublishOnly": "npm run lint && npm run test && npm run compile",
    "package": "vsce package --no-dependencies"
  },

  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^25.0.6",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
