{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch"],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "esbuild",
          "pattern": [
            {
              "regexp": "^(.*)$",
              "message": 1
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "\\[esbuild\\] watching",
            "endsPattern": "watching"
          }
        }
      ]
    },
    {
      "label": "build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "compile"],
      "problemMatcher": []
    }
  ]
}
