{
  "language": "node",
  "extension": ".js",
  "subgroup": "tooling",
  "commands": [
    {
      "id": "opensource:npx-eslint",
      "label": "npx eslint .",
      "command": "npx eslint ."
    },
    {
      "id": "opensource:npx-prettier-write",
      "label": "npx prettier --write .",
      "command": "npx prettier --write ."
    },
    {
      "id": "opensource:npx-jest",
      "label": "npx jest",
      "command": "npx jest"
    },
    {
      "id": "opensource:npx-vitest",
      "label": "npx vitest",
      "command": "npx vitest"
    },
    {
      "id": "opensource:npx-ts-node-src-index-ts",
      "label": "npx ts-node src/index.ts",
      "command": "npx ts-node src/index.ts"
    },
    {
      "id": "opensource:npx-tsx-src-index-ts",
      "label": "npx tsx src/index.ts",
      "command": "npx tsx src/index.ts"
    },
    {
      "id": "opensource:npx-webpack-config-webpack-config-js",
      "label": "npx webpack --config webpack.config.js",
      "command": "npx webpack --config webpack.config.js"
    }
  ]
}