{
  "language": "c",
  "extension": ".c",
  "subgroup": "build-systems",
  "commands": [
    {
      "id": "opensource:make",
      "label": "make",
      "command": "make"
    },
    {
      "id": "opensource:make-clean",
      "label": "make clean",
      "command": "make clean"
    },
    {
