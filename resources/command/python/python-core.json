{
  "language": "python",
  "extension": ".py",
  "subgroup": "python-core",
  "commands": [
    {
      "id": "opensource:python-version",
      "label": "python --version",
      "command": "python --version"
    },
    {
      "id": "opensource:python-main-py",
      "label": "python main.py",
      "command": "python main.py"
    },
    {
      "id": "opensource:python-m-venv-venv",
      "label": "python -m venv .venv",
      "command": "python -m venv .venv"
    },
    {
      "id": "opensource:python-m-http-server",
      "label": "python -m http.server",
      "command": "python -m http.server"
    },
    {
      "id": "opensource:python-m-build",
      "label": "python -m build",
      "command": "python -m build"
    },
    {
      "id": "opensource:python-m-twine-upload-dist",
      "label": "python -m twine upload dist/*",
      "command": "python -m twine upload dist/*"
    }
  ]
}